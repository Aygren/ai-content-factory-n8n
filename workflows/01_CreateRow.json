        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты профессиональный контент-стратег для соцсетей.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"На основе текста ниже создай 3 разных поста про флоатинг.\\n\\n\" +\n        \"1. Экспертный (польза, факты)\\n\" +\n        \"2. Сторителлинг (личный опыт)\\n\" +\n        \"3. Провокационный (ломает миф или вызывает эмоцию)\\n\\n\" +\n        \"Ответ верни СТРОГО как JSON объект.\\n\" +\n\"Без markdown.\\n\" +\n\"Без ```.\\n\" +\n\"Без пояснений.\\n\" +\n\"Только JSON.\\n\\n\" +\n\"Формат:\\n\" +\n\"{\\n\" +\n'  \"expert\": \"текст\",\\n' +\n'  \"story\": \"текст\",\\n' +\n'  \"provocation\": \"текст\"\\n' +\n\"}\\n\\n\" +\n        \"Текст:\\n\" +\n        ($json.text || \"нет данных\")\n    }\n  ],\n  \"temperature\": 0.8\n} }}",
