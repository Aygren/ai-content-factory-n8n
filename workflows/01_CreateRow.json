      "parameters": {
        "jsCode": "// Берем все входящие данные\nconst items = $input.all();\n\n// Склеиваем историю\nconst historyList = items.map(item => item.json.query).filter(q => q).join(', ');\n\n// ВАЖНО: Мы возвращаем НОВЫЙ массив. \n// Это разрывает цепочку \"много элементов на входе\"\nreturn [\n  {\n    json: {\n      history: historyList || \"записей нет, предложи темы сам\"\n    }\n  }\n];"
      },
