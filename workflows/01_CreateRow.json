    {
      "parameters": {
        "content": "## Генерируем статью в 3-х стилях\n## У каждой тройки свой batch_id",
        "height": 368,
        "width": 416
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -2720,
        1920
