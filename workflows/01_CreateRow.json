{
  "name": "CreateRow",
  "nodes": [
    {
      "parameters": {
        "functionCode": "// Берем результаты из Tavily\nconst results = $input.all()[0].json.results;\n\n// Оставляем только те результаты, где текста больше 300 символов \n// (так мы отсеем короткие обрывки)\nconst filteredResults = results.filter(r => r.content && r.content.length > 300);\n\n// Если ничего длинного не нашлось, берем хотя бы то, что есть\nconst finalResults = filteredResults.length > 0 ? filteredResults : results;\n\nreturn finalResults.map(r => ({ json: { text: r.content } }));"
      },
