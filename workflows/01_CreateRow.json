      "id": "514eb30a-0dab-4a34-acba-f04549de08b6",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "let result = [];\n\n// Функция для генерации короткого случайного ID\nconst generateId = () => Math.random().toString(36).substring(2, 9);\n\nfor (const item of items) {\n  const content = item.json.choices[0].message.content;\n\n  // Генерируем уникальный ID именно для этой итерации (для этой пачки из 3 постов)\n  const batchId = generateId(); \n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(content);\n  } catch (e) {\n    result.push({\n      json: {\n        error: \"JSON parse error\",\n        raw: content\n      }\n    });\n    continue;\n  }\n\n  // Добавляем batch_id к каждому объекту в этой тройке\n  result.push(\n    { json: { type: \"expert\", text: parsed.expert, batch_id: batchId } },\n    { json: { type: \"story\", text: parsed.story, batch_id: batchId } },\n    { json: { type: \"provocation\", text: parsed.provocation, batch_id: batchId } }\n  );\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
