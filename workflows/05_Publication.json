        "jsCode": "// Задаем наборы ключевых слов для флоатинга\nconst moods = [\n  \"deep relaxation, silk water, slow motion\",\n  \"inner peace, soft focus, ethereal glow\",\n  \"weightless suspension, cosmic tranquility, liquid zen\"\n];\n\n// Выбираем случайное настроение, чтобы картинки всегда были разными\nconst randomMood = moods[Math.floor(Math.random() * moods.length)];\n\nconst baseStyle = \"abstract fluid art, minimal composition, ethereal water ripples, soft pastel lighting, zen atmosphere, high resolution, no text, no letters\";\n\nreturn {\n  model: \"google/imagen4-fast\",\n  // Теперь в промпте НЕТ русского текста, только чистые визуальные команды\n  prompt: `A serene visual representation of ${randomMood}. Aesthetic: ${baseStyle}`,\n  aspect_ratio: \"16:9\"\n};"
